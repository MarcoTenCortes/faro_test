{
  "manifest_version": 3,
  "name": "Faro — copiloto para Jira y Confluence",
  "short_name": "Faro",
  "version": "1.0.0",
  "description": "Chatea con tu opencode local dentro de Jira y Confluence, y deja que te lleve hasta donde está la respuesta.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "src/assets/icon-16.png",
    "32": "src/assets/icon-32.png",
    "48": "src/assets/icon-48.png",
    "128": "src/assets/icon-128.png"
  },
  "action": {
    "default_title": "Abrir Faro",
    "default_icon": {
      "16": "src/assets/icon-16.png",
      "32": "src/assets/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/panel/panel.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://*.atlassian.net/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.atlassian.net/*"
      ],
      "js": [
        "src/content/bootstrap.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*.js",
        "src/content/overlay/*.js",
        "src/shared/*.js",
        "src/atlassian/*.js",
        "src/nav/*.js"
      ],
      "matches": [
        "https://*/*"
      ],
      "use_dynamic_url": true
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Abrir Faro"
    }
  },
  "key": ""
}
